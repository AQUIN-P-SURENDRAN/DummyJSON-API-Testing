    {
      "name": "Create new user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Verify response code is 200 or 201\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "",
              "",
              "pm.test(\"Verify response time is below 1000 ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "const response = pm.response.json();",
              "",
              "pm.test(\"Verify response contains expected fields\", function () {",
              "    pm.expect(response).to.have.property(\"id\");",
              "    pm.expect(response).to.have.property(\"firstName\");",
              "    pm.expect(response).to.have.property(\"lastName\");",
              "    pm.expect(response).to.have.property(\"age\");",
              "});",
              "",
              "pm.test(\"Verify created user details\", function () {",
              "    pm.expect(response.firstName).to.eql(\"Aquin\");",
              "    pm.expect(response.lastName).to.eql(\"Tester\");",
              "    pm.expect(response.age).to.eql(22);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
