    {
      "name": "Create new product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"Verify the status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Verify the response time is below 1000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "pm.test(\"Verify product ID is generated\", function () {",
              "    pm.expect(response).to.have.property(\"id\");",
              "    pm.expect(response.id).to.be.a(\"number\");",
              "});",
              "",
              "pm.test(\"Verify product title\", function () {",
              "    pm.expect(response.title).to.eql(\"Test Automation Product\");",
              "});",
              "",
              "pm.test(\"Verify product price\", function () {",
              "    pm.expect(response.price).to.eql(10);",
              "});",
              "",
              "pm.test(\"Verify product category\", function () {",
              "    pm.expect(response.category).to.eql(\"automation\");",
              "});",
              "",
              "pm.test(\"Validate product response structure\", function () {",
              "    pm.expect(response).to.have.property(\"id\");",
              "    pm.expect(response).to.have.property(\"title\");",
              "    pm.expect(response).to.have.property(\"price\");",
              "    pm.expect(response).to.have.property(\"category\");",
              "});"
